<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:GithubMirror.Views"
             x:Class="GithubMirror.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GithubMirror/Assets/Icons.axaml" />
                <ResourceInclude Source="avares://GithubMirror/Assets/Theme.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <views:PlatformBrushConverter x:Key="PlatformBrush" />
            <views:PlatformInitialsConverter x:Key="PlatformInitials" />
            <views:StatusGeometryConverter x:Key="StatusGeometry" />
            <views:StatusBrushConverter x:Key="StatusBrush" />
            <views:PrivacyGeometryConverter x:Key="PrivacyGeometry" />
            <views:PrivacyBrushConverter x:Key="PrivacyBrush" />
            <views:InverseBoolConverter x:Key="InverseBool" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- 文字 -->
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AppText}" />
        </Style>

        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AppMuted}" />
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource AppMuted}" />
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource AppMuted}" />
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppText}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- 專案名稱：看起來是連結、點了會用系統瀏覽器開啟專案頁面 -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.link:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.link:disabled">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <Style Selector="Button.link TextBlock.link-text">
            <Setter Property="Foreground" Value="{StaticResource AppAccent}" />
        </Style>

        <Style Selector="Button.link:pointerover TextBlock.link-text">
            <Setter Property="Foreground" Value="{StaticResource AppAccentDark}" />
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>

        <!-- 沒有網址可開時就退回一般文字，避免誤導使用者去點 -->
        <Style Selector="Button.link:disabled TextBlock.link-text">
            <Setter Property="Foreground" Value="{StaticResource AppText}" />
            <Setter Property="TextDecorations" Value="{x:Null}" />
        </Style>

        <Style Selector="Button.link PathIcon.link-icon">
            <Setter Property="Foreground" Value="{StaticResource AppAccent}" />
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="Button.link:pointerover PathIcon.link-icon">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.link:disabled PathIcon.link-icon">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- 卡片 -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource AppSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource AppSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorder}" />
        </Style>

        <!-- 平台徽章 -->
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
        </Style>

        <Style Selector="Border.badge-sm">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
        </Style>

        <Style Selector="TextBlock.badge-text">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.badge-text-sm">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 統計小標籤 -->
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{StaticResource AppSurfaceAlt}" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="10,4" />
        </Style>

        <!-- 輸入 -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="9,7" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="7" />
        </Style>

        <!-- 帳號清單 -->
        <Style Selector="ListBox.accounts">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="ListBox.accounts ListBoxItem">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- 進度條 -->
        <Style Selector="ProgressBar.thin">
            <Setter Property="Height" Value="5" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
        </Style>

        <!-- DataGrid -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="{StaticResource AppSurface}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="46" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
        </Style>
    </Application.Styles>
</Application>
